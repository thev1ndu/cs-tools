subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus2"
name            = "csm-alerting-dev"

tags = {
  product     = "csm"
  component   = "alerting-proxy"
  environment = "dev"
}

# One route and credential per monitoring tool.
sources = [
  "aws", "azure", "gcp", "site24x7", "datadog",
  "prometheus", "icinga", "elasticsearch", "opensearch", "openobserve",
  "servicenow",
]

# Decision D1: alerts whose body has "service" set to one of these go to alerts-high; everything else goes to alerts-normal.
high_tier_services = [
  "client-prod-alert-integration",
]

# Decision D12: cheapest dev setup. Developer_1 has no SLA and no zones; production uses Premium_2 with apim_zones = ["1", "2"].
apim_sku_name        = "Developer_1"
apim_zones           = []
apim_publisher_name  = "WSO2 SRE"
apim_publisher_email = "sre@example.com"

# Basic for dev (no IP firewall, no duplicate detection, 14 day archive); production uses Premium with servicebus_capacity = 1.
servicebus_sku      = "Basic"
servicebus_capacity = 1

# Dev: empty leaves the gateway public. Production copies https://www.cloudflare.com/ips-v4 at apply time.
cloudflare_ip_ranges = []

# Dev: every source logs in as test/test. Remove for production to get a generated password per source.
shared_credential = {
  username = "test"
  password = "test"
}

# Object ID of the identity CSM Alert Core authenticates as.
consumer_principal_ids = ["00000000-0000-0000-0000-000000000000"]
consumer_ip_ranges     = ["203.0.113.0/28"]
operator_ip_ranges     = ["198.51.100.10"]

alert_email_receivers = [
  { name = "sre", email_address = "sre@example.com" },
]
